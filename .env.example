# Copy this file to .env.local and fill in the values from
# Supabase dashboard > Project Settings > API.
# Only the public "anon" key belongs here. NEVER put the service_role key in this project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Name printed on certificates and shown on the verification page (default: CampusFlow).
VITE_INSTITUTION_NAME=
